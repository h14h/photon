#!/bin/sh
# Every check in every app, in dependency order: `mix precommit` and
# Dialyzer, then the coverage thresholds. Stops at the first failure.
#
# Needs Elixir 1.20 on OTP 28 on the PATH, e.g.
#   mise exec elixir@1.20.4-otp-28 erlang@28.5.0.7 -- scripts/verify
set -eu
cd "$(dirname "$0")/.."

case "$(elixir --short-version 2>/dev/null)" in
  1.20.*) ;;
  *) echo "scripts/verify needs Elixir 1.20; found: $(elixir --short-version 2>&1)" >&2; exit 1 ;;
esac

for app in core node hub; do
  echo "==> apps/$app"
  (
    cd "apps/$app"
    mix precommit
    # Dialyxir rechecks its PLT only when the deps' hash changes, which a
    # change to a path dependency (core, the node) doesn't. Dropping the
    # hash makes it recheck, so the PLT holds the code being checked.
    rm -f _build/plts/*.plt.hash
    mix dialyzer
  )
done

# The coverage thresholds. The hub's suite is mostly serial (one real
# database per VM), so it runs split across VMs.
(cd apps/core && mix test --cover)
(cd apps/node && mix test --cover)
scripts/test-partitioned hub
