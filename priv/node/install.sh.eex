#!/bin/sh
# Photon node installer, generated by the hub at <%= @hub_http %>
#
#   curl -fsSL <%= @hub_http %>/node/install.sh | PHOTON_NODE_TOKEN=<token> sh
#
# Installs the self-contained photon-node binary into ~/.local/share/photon-node,
# its settings into ~/.config/photon-node/env, and a user service that keeps it
# running (systemd on Linux, launchd on macOS). Needs no root.
#
# Environment:
#   PHOTON_NODE_TOKEN  the hub's node token (required to install)
#   PHOTON_NODE_ID     node name (default: short hostname)
#   PHOTON_SERVER      hub websocket (default: <%= @server_url %>)
#   PHOTON_ACTION      install (default) or uninstall
#   PHOTON_PURGE       with uninstall, 1 also deletes sessions and the workspace
#   PHOTON_BINARY      use this local binary instead of downloading one
#   PHOTON_SERVICE     systemd, launchd or none (default: detected)
set -eu

HUB_HTTP='<%= @hub_http %>'
PHOTON_SERVER="${PHOTON_SERVER:-<%= @server_url %>}"
ACTION="${PHOTON_ACTION:-install}"

say() { printf 'photon: %s\n' "$*"; }
fail() { printf 'photon: error: %s\n' "$*" >&2; exit 1; }

case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  *) fail "unsupported OS $(uname -s)" ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x86_64 ;;
  aarch64 | arm64) arch=aarch64 ;;
  *) fail "unsupported CPU $(uname -m)" ;;
esac

BASE="$HOME/.local/share/photon-node"
BIN="$BASE/bin/photon-node"
CONF="$HOME/.config/photon-node"
ENVFILE="$CONF/env"
LOG="$BASE/node.log"
PIDFILE="$BASE/node.pid"
LABEL=dev.photon.node
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
UNIT="$HOME/.config/systemd/user/photon-node.service"
uid=$(id -u)

service_kind() {
  if [ -n "${PHOTON_SERVICE:-}" ]; then echo "$PHOTON_SERVICE"
  elif [ "$os" = macos ]; then echo launchd
  elif command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd
  else echo none
  fi
}

stop_existing() {
  if [ -f "$UNIT" ]; then systemctl --user disable --now photon-node >/dev/null 2>&1 || true; fi
  if [ -f "$PLIST" ]; then
    launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1 || launchctl bootout "user/$uid/$LABEL" >/dev/null 2>&1 || true
  fi
  if [ -f "$PIDFILE" ]; then
    # The binary runs the Erlang VM as a child, so stop that too.
    pid=$(cat "$PIDFILE")
    pkill -TERM -P "$pid" >/dev/null 2>&1 || true
    kill "$pid" >/dev/null 2>&1 || true
    rm -f "$PIDFILE"
  fi
}

if [ "$ACTION" = uninstall ]; then
  stop_existing
  rm -f "$UNIT" "$PLIST" "$BIN" "$ENVFILE"
  if command -v systemctl >/dev/null 2>&1; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
  if [ "${PHOTON_PURGE:-}" = 1 ]; then rm -rf "$HOME/.photon-node" "$BASE"; fi
  say "uninstalled"
  echo PHOTON_UNINSTALL_OK
  exit 0
fi

[ "$ACTION" = install ] || fail "unknown PHOTON_ACTION $ACTION"
[ -n "${PHOTON_NODE_TOKEN:-}" ] || fail "set PHOTON_NODE_TOKEN (the hub shows it under Nodes → Add)"
PHOTON_NODE_ID="${PHOTON_NODE_ID:-$(hostname -s 2>/dev/null || hostname)}"
service=$(service_kind)
umask 077
mkdir -p "$BASE/bin" "$CONF"

if [ -n "${PHOTON_BINARY:-}" ]; then
  [ -f "$PHOTON_BINARY" ] || fail "no binary at $PHOTON_BINARY"
  mv "$PHOTON_BINARY" "$BIN.new"
else
  url="$HUB_HTTP/node/download/photon-node-$os-$arch"
  say "downloading $url"
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$url" -o "$BIN.new"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$BIN.new" "$url"
  else fail "need curl or wget to download the node"
  fi
fi
chmod 755 "$BIN.new"

# The first run unpacks the bundled runtime, so this also proves it can start.
version=$("$BIN.new" --version 2>&1) ||
  fail "the node binary didn't run ($version). If /tmp is mounted noexec, it can't start here."

stop_existing
mv "$BIN.new" "$BIN"

# Services start with a bare PATH, so keep the login shell's, where the agent's
# tools (git, brew, mise, ...) live.
shell="${SHELL:-/bin/sh}"
login_path=$("$shell" -lc 'printf "%s" "$PATH"' 2>/dev/null </dev/null | tail -n 1) || login_path=""
[ -n "$login_path" ] || login_path="$PATH"
for dir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
  case ":$login_path:" in *":$dir:"*) ;; *) [ -d "$dir" ] && login_path="$login_path:$dir" ;; esac
done

cat >"$ENVFILE" <<ENV
PHOTON_SERVER=$PHOTON_SERVER
PHOTON_NODE_TOKEN=$PHOTON_NODE_TOKEN
PHOTON_NODE_ID=$PHOTON_NODE_ID
SHELL=$shell
PATH=$login_path
ENV

case "$service" in
  systemd)
    mkdir -p "$(dirname "$UNIT")"
    cat >"$UNIT" <<UNIT
[Unit]
Description=Photon node (unreal-agent harness)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/photon-node/env
ExecStart=%h/.local/share/photon-node/bin/photon-node
WorkingDirectory=%h
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
UNIT
    systemctl --user daemon-reload
    systemctl --user enable --now photon-node
    user=$(id -un)
    if [ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null)" != yes ]; then
      loginctl enable-linger "$user" >/dev/null 2>&1 ||
        say "warning: the node stops when $user logs out. Keep it running with: sudo loginctl enable-linger $user"
    fi
    ;;
  launchd)
    mkdir -p "$(dirname "$PLIST")"
    xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0"><dict>'
      echo "  <key>Label</key><string>$LABEL</string>"
      echo "  <key>ProgramArguments</key><array><string>$(xml "$BIN")</string></array>"
      echo '  <key>EnvironmentVariables</key><dict>'
      while IFS='=' read -r key value; do
        echo "    <key>$key</key><string>$(xml "$value")</string>"
      done <"$ENVFILE"
      echo '  </dict>'
      echo "  <key>WorkingDirectory</key><string>$(xml "$HOME")</string>"
      echo '  <key>RunAtLoad</key><true/>'
      echo '  <key>KeepAlive</key><true/>'
      echo "  <key>StandardOutPath</key><string>$(xml "$LOG")</string>"
      echo "  <key>StandardErrorPath</key><string>$(xml "$LOG")</string>"
      echo '</dict></plist>'
    } >"$PLIST"
    launchctl bootstrap "gui/$uid" "$PLIST" >/dev/null 2>&1 || launchctl bootstrap "user/$uid" "$PLIST"
    ;;
  none)
    (set -a; . "$ENVFILE"; set +a; nohup "$BIN" >>"$LOG" 2>&1 </dev/null & echo $! >"$PIDFILE")
    say "warning: no service manager found, so the node won't restart after a reboot"
    ;;
  *) fail "unknown PHOTON_SERVICE $service" ;;
esac

say "installed photon-node $version as \"$PHOTON_NODE_ID\" ($service, $os-$arch)"
echo PHOTON_INSTALL_OK
