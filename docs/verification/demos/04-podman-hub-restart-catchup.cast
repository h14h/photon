[0.004106, "o", "\r\nLayer 4 — podman hub-restart catch-up\r\nphoton-hub and photon-node on network photon-demo.\r\nPHOTON_PUBLIC_URL=http://photon-hub:4000\r\nPHOTON_SERVER=ws://photon-hub:4000/node/websocket\r\nPHOTON_NODE_ID=box\r\nPHOTON_NODE_TOKEN is read from the hub data volume and is not printed.\r\n\r\n"]
[0.033851, "o", "NAMES        STATUS         PORTS\r\nphoton-hub   Up 43 seconds  127.0.0.1:4000->4000/tcp\r\nphoton-node  Up 3 minutes   \r\n"]
[0.037144, "o", "\r\nSidebar names box before the run:\r\n"]
[0.047981, "o", ">box<\r\n"]
[0.667917, "o", "wrote sidebar-before.png\r\n\r\n$ send sleep 12 on node box\r\n"]
[1.311741, "o", "http://127.0.0.1:4000/s/dcfabebc-4809-4cc3-a069-5eb4ba4445c3\r\n"]
[1.313679, "o", "session dcfabebc-4809-4cc3-a069-5eb4ba4445c3\r\n"]
[1.315978, "o", "node log has 6 lines and no exit yet\r\n\r\n$ podman kill photon-hub\r\n"]
[1.410878, "o", "photon-hub\r\n"]
[1.413446, "o", "hub health: "]
[1.417615, "o", "curl: (7) Failed to connect to 127.0.0.1 port 4000 after 0 ms: Couldn't connect to server\r\n"]
[1.417895, "o", "down\r\nwaiting for the node to commit exit while the hub process is dead...\r\n"]
[40.523051, "o", "node exit committed at 40s, node lines=10, hub lines=6, hub exits=0\r\n"]
[40.525007, "o", "\r\n$ podman start photon-hub\r\n"]
[40.643915, "o", "photon-hub\r\n"]
[40.647531, "o", "waiting for box to rejoin and the hub log to catch up...\r\n"]
[48.310911, "o", "caught up after 8s\r\n"]
[48.327652, "o", "hub_lines=10 node_lines=10 equal=True\r\nhub_exits=1 node_exits=1\r\n"]
[49.000123, "o", "wrote sidebar-after.png\r\n\r\nOracle passed: one exit in both jsonl files, line for line, box online again.\r\n"]
